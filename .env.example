# ==============================================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# NUNCA insira tokens ou senhas reais neste arquivo.
# Copie este arquivo para .env e preencha com suas credenciais reais.
# ==============================================================================

# Access Token de Produção ou Teste do Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-SEU_ACCESS_TOKEN_AQUI

# Origens permitidas para CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5000,http://localhost:5000

# Porta do Servidor Flask
PORT=5000

# Ativar Debug apenas em desenvolvimento local (False em produção)
FLASK_DEBUG=False
